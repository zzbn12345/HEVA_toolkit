{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heva.example.org/schemas/heva-people.schema.json",
  "title": "HEVA project people registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "active_curator_id", "people"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "active_curator_id": {
      "type": ["string", "null"],
      "pattern": "^PERSON-[A-Z0-9]+$"
    },
    "people": {
      "type": "array",
      "items": {"$ref": "#/$defs/person"}
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "name",
        "roles",
        "affiliation",
        "email",
        "orcid"
      ],
      "properties": {
        "person_id": {
          "type": "string",
          "pattern": "^PERSON-[A-Z0-9]+$"
        },
        "name": {"type": "string", "minLength": 1},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["annotator", "curator", "data_owner"]
          }
        },
        "affiliation": {"type": ["string", "null"]},
        "email": {
          "type": ["string", "null"],
          "format": "email"
        },
        "orcid": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{4}-\\d{4}-[\\dX]{4}$"
        }
      }
    }
  }
}
