{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heva.example.org/schemas/heva-color-configurations.schema.json",
  "title": "HEVA project color-configuration registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selected", "configurations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "selected": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/selection"}
      ]
    },
    "configurations": {
      "type": "array",
      "items": {"$ref": "#/$defs/configuration"}
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "version", "selected_by", "selected_at"],
      "properties": {
        "configuration_id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "selected_by": {"type": "string", "pattern": "^PERSON-[A-Z0-9]+$"},
        "selected_at": {"type": "string", "format": "date-time"}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "hexes"],
      "properties": {
        "label": {
          "enum": [
            "social",
            "economic",
            "political",
            "historic",
            "aesthetical",
            "scientific",
            "age",
            "ecological"
          ]
        },
        "hexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^#[0-9A-F]{6}$"}
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_id",
        "version",
        "name",
        "description",
        "mappings",
        "created_by",
        "created_at"
      ],
      "properties": {
        "configuration_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/mapping"}
        },
        "created_by": {"type": "string", "pattern": "^PERSON-[A-Z0-9]+$"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
