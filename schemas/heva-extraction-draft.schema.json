{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heva.example/schemas/heva-extraction-draft.schema.json",
  "title": "HEVA unresolved extraction draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "source_checksum_sha256", "extractor", "extractor_version", "generated_by", "generated_at", "sentences"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "minLength": 1},
    "source_checksum_sha256": {"type": "string", "minLength": 1},
    "extractor": {"type": "string", "minLength": 1},
    "extractor_version": {"type": "string", "minLength": 1},
    "generated_by": {"type": "string", "pattern": "^PERSON-[A-Z0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "sentences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sentence"}}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "text", "color", "label", "mapping_status"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1},
        "color": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
        "label": {"type": "null"},
        "mapping_status": {"const": "unresolved"}
      }
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentence_id", "page", "sentence", "tokens", "entities", "ner_tags"],
      "properties": {
        "sentence_id": {"type": "integer", "minimum": 1},
        "page": {"type": "integer", "minimum": 1},
        "sentence": {"type": "string"},
        "tokens": {"type": "array", "items": {"type": "string"}},
        "entities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
        "ner_tags": {"type": "array", "items": {"type": "string", "pattern": "^(O|[BI]-#[0-9A-F]{6})$"}}
      }
    }
  }
}
